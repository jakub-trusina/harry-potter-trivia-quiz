{
  "name": "hogwarts-conqueror",
  "version": "1.0.0",
  "description": "A Harry Potter themed territory conquest game",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "npm run build:client && npm run build:server && npm run copy-static",
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "ts-node --esm src/server.ts",
    "copy-static": "mkdir -p dist/public && cp -r src/public/* dist/public/ && mkdir -p dist/public/js/types && mkdir -p dist/public/js/utils && cp -r src/types dist/public/js/ && cp -r src/utils dist/public/js/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "npm test tests/unit",
    "test:integration": "npm test tests/integration",
    "test:e2e": "npm test tests/e2e",
    "test:coverage": "npm test -- --coverage",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "@testing-library/jest-dom": "^6.4.2",
    "supertest": "^6.3.4"
  }
} 